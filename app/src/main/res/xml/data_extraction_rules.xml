<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same exclusions as backup_rules.xml, for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="crash_guard.xml" />
        <exclude domain="file" path="last_crash.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="crash_guard.xml" />
        <exclude domain="file" path="last_crash.txt" />
    </device-transfer>
</data-extraction-rules>
